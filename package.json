{
  "name": "yuemi-office",
  "private": true,
  "version": "0.1.0",
  "description": "AI-assisted Markdown document studio",
  "workspaces": [
    "apps/desktop",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "bun run --cwd apps/desktop tauri dev",
    "build": "bun run --cwd packages/protocol build && bun run --cwd apps/desktop build",
    "test": "bun run --cwd packages/protocol test && bun run --cwd apps/desktop test",
    "typecheck": "bun run typecheck:scripts && bun run --cwd packages/protocol typecheck && bun run --cwd apps/desktop typecheck",
    "typecheck:scripts": "tsc -p tsconfig.json --noEmit",
    "lint": "bun run lint:eslint && bun run lint:prettier",
    "lint:changed": "bun run scripts/lint-changed.ts",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check .",
    "format": "prettier --write .",
    "build:desktop": "bun run scripts/build-desktop.ts",
    "build:desktop:debug": "bun run scripts/build-desktop.ts --debug",
    "set-version": "bun run scripts/set-version.ts",
    "package-version": "bun run scripts/package-version.ts",
    "version:report": "bun run scripts/version-report.ts",
    "icons": "bun run scripts/generate-icons.ts",
    "tauri": "bun run --cwd apps/desktop tauri",
    "prepare": "husky"
  },
  "engines": {
    "bun": ">=1.2"
  },
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/bun": "^1.4.4",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "9.1.7",
    "prettier": "^3.10.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.2"
  }
}
