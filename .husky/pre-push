# The lint that runs before a push.
#
# The CI runs the same three linters on every push, but the CI only speaks
# after the branch is already on the server. A hook that runs here turns a
# red build into a message that arrives before the push, while the mistake
# is still in the working tree.
#
# The hook runs the scripts under .github/scripts, the same ones the CI
# calls, so there is one set of lint rules and not two.
#
# The file has no shebang of its own. Husky runs it with `sh -e`, and a
# shebang would only say what the runner already says.

set -eu

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

echo "== Linting before the push"

# The scripts are POSIX shell, and they are called with `sh`. The hook
# runner is the same on every platform, so a script that needed a shell
# that is not always there would fail on the machine of the person who
# pushes rather than on a runner.
sh .github/scripts/lint-frontend.sh

sh .github/scripts/lint-rust.sh

# The backend lint runs inside the render image, so it needs a Docker
# daemon. A machine without one still pushes: the CI runs the backend
# lint on every push anyway, so nothing is lost, only moved to the
# runner. A daemon that is not running is reported rather than hidden,
# because a silent skip reads like a lint that passed.
if docker info >/dev/null 2>&1; then
  sh .github/scripts/lint-backend.sh
else
  echo "== The render service was not linted: no Docker daemon is running."
  echo "== The CI lints it on every push."
fi
