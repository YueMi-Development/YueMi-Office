# The things Prettier does not format.
#
# The files listed here are either generated, or written by a tool that
# owns their format, or content rather than code.

node_modules/
dist/
target/
bun.lock

# The Rust side has its own formatter.
apps/desktop/src-tauri/

# The example project is a sample document, not source. Its wording and
# its layout belong to the reader of the sample.
examples/

# The other files in YAML are read by another program rather than by a
# person: the compose file by Docker, the dependabot file by GitHub. A
# formatter would change the quoting of their strings, and the tests that
# read them would then look for a shape that the file no longer has.
*.yml
*.yaml

# The prose is written to be read, and the way it is wrapped is part of how
# it reads. A formatter would reflow the PRD and the documentation, and
# the result would say nothing that the text did not already say.
*.md
docs/
apps/api/tests/fixtures/

# The generated files. They are written by a script of the service, and the
# script writes them in its own shape, so a formatter here would only make
# the next run of the script change them again.
packages/protocol/src/fixtures/
apps/api/tests/visual/baseline/
