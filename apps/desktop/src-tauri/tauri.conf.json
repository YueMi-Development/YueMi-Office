{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "yuemi",
  "version": "0.2.0-alpha",
  "identifier": "app.yuemi.office",
  "mainBinaryName": "yuemi",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run icons && bun run dev",
    "beforeBuildCommand": "bun run icons && bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "yuemi",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "version": "0.2.0.0"
      }
    },
    "macOS": {
      "bundleVersion": "0.2.0"
    }
  }
}
